[sub_resource type="GDScript" id="GDScript_0xm2m"]
script/source = "extends Node2D

var game_over = false
var score = 9
var drop_speed = 300
 
func _ready() -> void:
	randomize()
	get_tree().paused = true
	$HBoxContainer.visible = false
	for i in str(score):
		var t = TextureRect.new()
		t.texture = load(\"res://sprites/{0}.png\".format([i], '{_}'))
		$\"HBoxContainer\".add_child(t)


func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"jump\") and not game_over:
		get_tree().paused = false
		$HBoxContainer.visible = true
		$Button.visible = false
	if game_over:
		get_tree().paused = true
		$Button.visible = true
		$HBoxContainer.visible = false
		$CharacterBody2D.rotation_degrees = 60
		$CharacterBody2D.position.y += drop_speed * delta
		drop_speed += 100 * delta
	if Input.is_action_just_pressed(\"restart\"):
		if $Button.visible:
			get_tree().reload_current_scene()
		elif not game_over:
			get_tree().paused = true
			$Button.visible = true
			$HBoxContainer.visible = false

func _on_timer_timeout() -> void:
	var pipe: Area2D = preload(\"res://pipe.tscn\").instantiate()
	pipe.position = Vector2(330.0, randi_range(-120, 150))
	add_child(pipe)


func _on_button_pressed() -> void:
	get_tree().reload_current_scene()
"

[sub_resource type="GDScript" id="GDScript_1bvp3"]
script/source = "extends TextureRect


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	size.x += 1
	position.x -= 1
	
"

